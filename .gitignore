# GitHub не принимает файлы больше 100 МБ (helium.AppImage — 152 МБ),
# пуш с ними сломается. Два варианта:
#   1) оставить как есть: AppImage живут вне git, на место друга
#      попадают флешкой/по сети в Applications/ — скрипт их подхватит;
#   2) использовать git lfs: удали строку ниже и сделай
#      git lfs track "*.AppImage"
Applications/*.AppImage

# локальный мусор
*.save
*.hmbak
